[options]
mode cover
depth 28
timeout 480
multiclock off

[engines]
smtbmc yices

[script]
read_verilog -formal -sv -DFORMAL -DSYNTHESIS -DFORMAL_CLOSURE "inputs/rtl/cmdbuf_rd_cmd.v" "inputs/rtl/cmdbuf_rd_otb.v" "inputs/rtl/cmdbuf_rd.v" "inputs/formal/cmdbuf_rd_formal.sv"
prep -top cmdbuf_rd_formal

[files]
inputs

  connect \r_port_id \dut.r_port_id
  connect \raddr \dut.raddr
  connect \dut.rd_mem_status \rd_mem_status
  connect \rdata \dut.rdata
  connect \req \dut.req
  connect \rid \dut.rid
  connect \dut.rready \rready
  connect \rresp \dut.rresp
  connect \dut.rst_n \rst_n
  connect \rvalid \dut.rvalid
  connect \dut.rw_rd_gnt \rw_rd_gnt
  connect \dut.src \src
end

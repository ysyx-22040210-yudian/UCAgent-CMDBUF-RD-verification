[options]
mode prove
depth 2
timeout 120
multiclock off

[engines]
smtbmc yices

[script]
read_verilog -formal -sv -DFORMAL -DSYNTHESIS "inputs/rtl/cmdbuf_rd.v" "inputs/rtl/cmdbuf_rd_cmd.v" "inputs/rtl/cmdbuf_rd_otb.v" "inputs/formal/quota_step_math.sv"
prep -top quota_step_math

[files]
inputs

[options]
mode bmc
depth 10
timeout 180

[engines]
smtbmc yices

[script]
read_slang --top cmdbuf_rd_formal --no-implicit-memories -D SYNTHESIS cmdbuf_rd.sv cmdbuf_rd_cmd.sv cmdbuf_rd_otb.sv cmdbuf_rd_value_bag.sv cmdbuf_rd_relaxed_sva.sv formal_top.sv
prep -top cmdbuf_rd_formal
async2sync
dffunmap
chformal -lower
sim -clock clk -resetn rst_n -rstlen 1 -n 1 -w -vcd reset_initialization.vcd

[files]
cmdbuf_rd.sv
cmdbuf_rd_cmd.sv
cmdbuf_rd_otb.sv
cmdbuf_rd_value_bag.sv
cmdbuf_rd_relaxed_sva.sv
formal_top.sv
